<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Arefin's Hot Chilli Restaurant</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: #f8f8f8;
            color: #222;
        }

        /* NAVBAR */
        nav {
            background: #222;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        nav h2 {
            color: #fff;
            font-size: 28px;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 25px;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            font-size: 16px;
        }

        nav ul li a:hover {
            color: #ff9800;
        }

        /* HERO */
        .hero {
            min-height: 90vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 30px;
            background:
                linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)),
                url("https://images.unsplash.com/photo-1517248135467-4c7edcad34c4")
                center/cover;
        }

        .hero-content {
            color: white;
            max-width: 700px;
        }

        .hero h1 {
            font-size: 60px;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 20px;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            background: #ff9800;
            color: white;
            padding: 13px 28px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            background: #e68900;
            transform: scale(1.05);
        }

        /* GENERAL SECTION */
        section {
            padding: 80px 8%;
        }

        section h2 {
            text-align: center;
            font-size: 38px;
            margin-bottom: 15px;
        }

        section > p {
            text-align: center;
            color: #666;
            margin-bottom: 45px;
        }

        /* MENU */
        .menu-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
        }

        .food-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: 0.3s;
        }

        .food-card:hover {
            transform: translateY(-8px);
        }

        .food-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .food-info {
            padding: 20px;
        }

        .food-info h3 {
            margin-bottom: 10px;
            font-size: 22px;
        }

        .food-info p {
            color: #666;
            margin-bottom: 12px;
        }

        .price {
            font-size: 20px;
            font-weight: bold;
            color: #ff9800;
        }

        /* ABOUT */
        #about {
            background: #fff;
        }

        .about-container {
            display: flex;
            gap: 40px;
            align-items: center;
            flex-wrap: wrap;
        }

        .about-container img {
            width: 100%;
            max-width: 500px;
            border-radius: 12px;
        }

        .about-text {
            flex: 1;
            min-width: 280px;
        }

        .about-text p {
            line-height: 1.8;
            color: #555;
            margin-top: 15px;
        }

        /* CONTACT */
        .contact-box {
            max-width: 700px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .contact-box input,
        .contact-box textarea {
            width: 100%;
            padding: 13px;
            margin: 10px 0;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        .contact-box textarea {
            height: 120px;
            resize: none;
        }

        .contact-box button {
            width: 100%;
            padding: 13px;
            border: none;
            background: #ff9800;
            color: white;
            font-size: 17px;
            border-radius: 6px;
            cursor: pointer;
        }

        .contact-box button:hover {
            background: #e68900;
        }

        /* FOOTER */
        footer {
            background: #222;
            color: white;
            text-align: center;
            padding: 25px;
        }

        /* MOBILE */
        @media (max-width: 768px) {

            nav {
                flex-direction: column;
                gap: 15px;
            }

            nav ul {
                gap: 15px;
                flex-wrap: wrap;
                justify-content: center;
            }

            .hero h1 {
                font-size: 42px;
            }

            .hero p {
                font-size: 17px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVIGATION -->
    <nav>
        <h2>Spice Garden</h2>

        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#menu">Menu</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>


    <!-- HERO -->
    <section class="hero" id="home">

        <div class="hero-content">

            <h1>Welcome to Arefin's kitchen</h1>

            <p>
                Delicious food, beautiful moments and unforgettable taste.
            </p>

            <a href="#menu" class="btn">
                Explore Menu
            </a>

        </div>

    </section>


    <!-- MENU -->
    <section id="menu">

        <h2>Our Popular Menu</h2>

        <p>
            Freshly prepared dishes made with quality ingredients.
        </p>

        <div class="menu-container">

            <div class="food-card">

                <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38"
                     alt="Pizza">

                <div class="food-info">

                    <h3>Cheese Pizza</h3>

                    <p>
                        Delicious pizza topped with fresh cheese.
                    </p>

                    <div class="price">৳450</div>

                </div>

            </div>


            <div class="food-card">

                <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd"
                     alt="Burger">

                <div class="food-info">

                    <h3>Classic Burger</h3>

                    <p>
                        Juicy beef burger with fresh vegetables.
                    </p>

                    <div class="price">৳280</div>

                </div>

            </div>


            <div class="food-card">

                <img src="https://images.unsplash.com/photo-1603133872878-684f208fb84b"
                     alt="Fried Rice">

                <div class="food-info">

                    <h3>Special Fried Rice</h3>

                    <p>
                        Flavorful fried rice with fresh ingredients.
                    </p>

                    <div class="price">৳320</div>

                </div>

            </div>


            <div class="food-card">

                <img src="https://images.unsplash.com/photo-1547592180-85f173990554"
                     alt="Pasta">

                <div class="food-info">

                    <h3>Creamy Pasta</h3>

                    <p>
                        Rich and creamy pasta with delicious sauce.
                    </p>

                    <div class="price">৳350</div>

                </div>

            </div>

        </div>

    </section>


    <!-- ABOUT -->
    <section id="about">

        <h2>About Us</h2>

        <div class="about-container">

            <img
                src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0"
                alt="Restaurant">

            <div class="about-text">

                <h3>Where Great Food Meets Great Moments</h3>

                <p>
                    Spice Garden is a modern restaurant focused on serving
                    delicious food in a comfortable environment.
                </p>

                <p>
                    Our chefs use fresh ingredients and carefully prepared
                    recipes to create memorable dishes for our customers.
                </p>

            </div>

        </div>

    </section>


    <!-- CONTACT -->
    <section id="contact">

        <h2>Contact Us</h2>

        <p>
            Have a question or want to make a reservation?
        </p>

        <div class="contact-box">

            <input
                type="text"
                id="name"
                placeholder="Your Name"
            >

            <input
                type="email"
                id="email"
                placeholder="Your Email"
            >

            <textarea
                id="message"
                placeholder="Your Message">
            </textarea>

            <button onclick="sendMessage()">
                Send Message
            </button>

        </div>

    </section>


    <!-- FOOTER -->
    <footer>

        <p>
            © 2026 Spice Garden Restaurant | All Rights Reserved
        </p>

    </footer>


    <!-- JAVASCRIPT -->
    <script>

        function sendMessage() {

            const name =
                document.getElementById("name").value;

            const email =
                document.getElementById("email").value;

            const message =
                document.getElementById("message").value;

            if (name === "" || email === "" || message === "") {

                alert("Please fill in all fields.");

                return;
            }

            alert(
                "Thank you, " +
                name +
                "! Your message has been received."
            );

        }

    </script>

</body>
</html>